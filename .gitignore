# Whitelist: only the shared AI infrastructure is versioned here.
# Projects are separate git repos next to this folder; vendor/ holds external clones.
/*
!/.gitignore
!/.gitattributes
!/.gitleaks.toml
!/.pre-commit-config.yaml
!/CLAUDE.md
!/AGENTS.md
!/README.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/.editorconfig
!/.claude/
!/.codex/
/.codex/*
!/.codex/agents/
!/.githooks/
!/.github/
!/docs/
!/clients/
!/workshop/
!/prompts/
!/scripts/

# --- Defense in depth: secrets and machine-specific files -------------------
# The whitelist above re-includes whole folders (.claude/, docs/, ...). These
# patterns are listed AFTER it so they still apply inside those folders.
# Never commit credentials; see SECURITY.md.

# Environment files (templates with placeholder names only are allowed)
.env
.env.*
!.env.example

# Private keys, certificates with keys, keystores, password databases
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
*.kdbx
id_rsa
id_dsa
id_ecdsa
id_ed25519
.ssh/

# Tokens and credential files of common tools
*.token
.credentials.json
credentials*.json
*service-account*.json
.git-credentials
.netrc
_netrc
.npmrc
.pypirc
.pgpass
.aws/
.docker/config.json

# Claude Code personal / machine-specific state (shared settings.json is allowed)
.claude.json
settings.local.json
.claude/worktrees/

# Codex CLI personal / machine-specific state (only generated .codex/agents/ is versioned)
auth.json
.codex-log/

# Python bytecode from scripts/
__pycache__/
