# Git hooks are POSIX shell scripts: keep LF endings so they run under
# Git for Windows (even with core.autocrlf=true), macOS and Linux.
.githooks/** text eol=lf
*.sh text eol=lf
# Generated Codex adapters are compared byte-for-byte by ai-infra/scripts/codex-adapter.py.
.codex/agents/*.toml text eol=lf
